{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Octave: Run current file",
      "type": "shell",
      "command": "octave",
      "args": [
        "--quiet",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
